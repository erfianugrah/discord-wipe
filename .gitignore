# Secrets. `.env` IS committed — but ONLY SOPS-encrypted at rest (age recipient
# = composer.erfi.io's public key; see .sops.yaml). Composer decrypts it at
# deploy time. The pre-commit hook (.git/hooks/pre-commit) blocks any commit
# where .env is still plaintext. NEVER commit a plaintext .env.
#   encrypt:  sops -e -i .env      decrypt-to-edit:  sops -d -i .env

# Runtime state.
state/
*.tmp
*.json.tmp

# The Discord export contains every DM you've ever sent.
# Bind-mount it at runtime; do not ship it inside the repo.
export/

# Python ephemera.
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editor / OS.
.DS_Store
.vscode/
.idea/

# Tooling caches.
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Dry-run state — separate from production state but still local-only.
state-*/
