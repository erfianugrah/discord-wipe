# Copy this file to .env and fill in your token. Never commit .env.
#
# Get your user token from a browser logged in to Discord:
#   1. Open DevTools (F12) -> Network tab.
#   2. Send any message in any channel.
#   3. Find the request to /api/v9/channels/.../messages.
#   4. Copy the `Authorization` request header value.
#
# That string IS your account - guard it like a password. Rotating it
# (log out -> log in) invalidates the old one.

DISCORD_TOKEN=replace-me

# Optional overrides (defaults baked into compose.yaml / Dockerfile):
# RETENTION_DAYS=14
# DELETE_DELAY=1.0
# SEARCH_DELAY=30.0
# INTERVAL_HOURS=24
# WATCH=1

# Transient-network retry (v0.4.1+). Discord-bound calls retry
# connection-level failures (DNS resolution / reset / timeout) before
# giving up, so a host-reboot "discord.com not yet resolvable" blip
# doesn't crash the daemon. Defaults give ~2min ride-out per call.
# NET_RETRY_MAX=8      # attempts per call
# NET_RETRY_BASE=2.0   # backoff base seconds (doubles each attempt)
# NET_RETRY_CAP=30.0   # max backoff seconds
